{"$schema":"https://json-schema.org/draft/2020-12/schema","title":"SportsEdge Muse league contract sidecar v1","description":"Ingestion-only full-game records; not CBBD canonical identities or verified settlement contracts. board_row is a 1-based data-row ordinal excluding the CSV header. price_a is home for SPREAD/ML and over for TOTAL. Minute capture windows are conservative envelopes; primary runner gates remain mandatory.","type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["board_row","sport","away","home","market","line","price_a","price_b","dk_event_id","tipoff_ct","period","settlement_rules_verified","source_comment_id","capture_start_ct","capture_end_ct","eligible_for_pricing"],"properties":{"board_row":{"type":"integer","minimum":1},"sport":{"const":"CBB"},"away":{"type":"string","minLength":1},"home":{"type":"string","minLength":1},"market":{"enum":["SPREAD","TOTAL","ML"]},"line":{"oneOf":[{"type":"number"},{"const":""}]},"price_a":{"type":"integer","anyOf":[{"minimum":100},{"maximum":-100}]},"price_b":{"type":"integer","anyOf":[{"minimum":100},{"maximum":-100}]},"dk_event_id":{"type":"string","pattern":"^[0-9]+$"},"tipoff_ct":{"type":"string","format":"date-time"},"period":{"const":"FULL_GAME"},"settlement_rules_verified":{"const":false},"source_comment_id":{"type":"integer","minimum":1},"capture_start_ct":{"type":"string","format":"date-time"},"capture_end_ct":{"type":"string","format":"date-time"},"eligible_for_pricing":{"const":false}},"allOf":[{"if":{"properties":{"market":{"const":"ML"}}},"then":{"properties":{"line":{"const":""}}},"else":{"properties":{"line":{"type":"number"}}}}]}}
